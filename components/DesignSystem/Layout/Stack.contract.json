{
  "$schema": "../contracts/ds-component-contract.v1.json",
  "id": "Stack",
  "kind": "wrapper",
  "version": "0.2.6",
  "purpose": "Vertical layout primitive (flex-direction: column).",
  "importFrom": ["@appdirect/ds-prototype-kit", "@/components/DesignSystem"],
  "mantineCounterpart": "Stack",
  "api": {
    "props": {
      "gap": {
        "enum": ["none", "xxs", "xs", "sm", "md", "lg", "xl", "xxl"],
        "default": "md",
        "notes": "Mantine Core xs–xl plus none (0), xxs (4), xxl (48). Also accepts string | number passthrough."
      },
      "align": {
        "enum": ["stretch", "flex-start", "flex-end", "center", "baseline"],
        "default": "stretch"
      },
      "justify": {
        "enum": ["flex-start", "flex-end", "center", "space-between", "space-around", "space-evenly"],
        "default": "flex-start"
      }
    }
  },
  "deprecatedPatterns": [
    "import { Stack } from '@mantine/core'"
  ],
  "enforcement": {
    "deterministic": ["importFrom", "api.props.gap.enum"],
    "semantic": ["purpose"]
  }
}
