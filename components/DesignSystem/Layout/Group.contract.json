{
  "$schema": "../contracts/ds-component-contract.v1.json",
  "id": "Group",
  "kind": "wrapper",
  "version": "0.2.6",
  "purpose": "Mantine-named alias of Inline. Prefer Inline for new Figma-mapped and prototype code.",
  "importFrom": ["@appdirect/ds-prototype-kit", "@/components/DesignSystem"],
  "mantineCounterpart": "Group",
  "aliasOf": "Inline",
  "api": {
    "props": {
      "gap": {
        "enum": ["none", "xxs", "xs", "sm", "md", "lg", "xl", "xxl"],
        "default": "md"
      }
    }
  },
  "composition": {
    "preferInstead": { "newCode": "Inline" }
  },
  "enforcement": {
    "deterministic": ["importFrom", "api.props.gap.enum", "aliasOf"],
    "semantic": ["composition.preferInstead.newCode"]
  }
}
