{
  "name": "@appdirect/ds-prototype-kit",
  "version": "0.2.4",
  "description": "AppDirect Design System components for prototyping. Wraps Mantine v9 with standardized props, variants, and tokens.",
  "main": "./dist/index.ts",
  "types": "./dist/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.ts",
      "default": "./dist/index.ts"
    },
    "./config": {
      "types": "./dist/config.ts",
      "default": "./dist/config.ts"
    },
    "./types": {
      "types": "./dist/types.ts",
      "default": "./dist/types.ts"
    },
    "./css/foundations.css": "./dist/css/foundations.css",
    "./css/mantine.css": "./dist/css/mantine.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/build.js",
    "tarball": "npm run build && npm pack",
    "verify:package": "npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mantine/dropzone": "^9.0.1",
    "@remixicon/react": "^4.6.0",
    "@tabler/icons-react": "^3.33.0",
    "mantine-react-table-open": "^9.0.3"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.1",
    "@mantine/dates": "^9.0.1",
    "@mantine/hooks": "^9.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ad-dc/appdirect-design-system.git"
  },
  "license": "UNLICENSED"
}
